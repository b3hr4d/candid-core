// Sovereign Wallet v1.2.0 — adds paged transaction history. Still additive:
// nothing a v1.0.0 or v1.1.0 client calls has moved.
import "common.did";

type TransferArgs = record {
  to : principal;
  amount : Tokens;
  memo : Memo;
};

type TransferError = variant {
  InsufficientFunds : record { balance : Tokens };
  BadFee : record { expected : Tokens };
};

type TransferResult = variant { Ok : nat64; Err : TransferError };

type Transaction = record {
  at : nat64;
  counterparty : principal;
  amount : Tokens;
  memo : Memo;
};

type Page = record { start : nat64; length : nat64 };

service : {
  balance : () -> (Tokens) query;
  owner : () -> (principal) query;
  transactions : (Page) -> (vec Transaction) query;
  transfer : (TransferArgs) -> (TransferResult);
  wallet_version : () -> (text) query;
}
