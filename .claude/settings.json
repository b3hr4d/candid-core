{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-typescript.sh\"",
            "statusMessage": "Formatting TypeScript",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
