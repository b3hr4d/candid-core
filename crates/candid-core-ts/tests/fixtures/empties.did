// Issue #126: `empty` in every composite position the AnyFieldSchema bound
// admits. A variant with an `empty` arm is deliberately absent until the
// classification divergence (#127) lands; vec/opt are the always-worked
// controls the acceptance criteria pin.
type EmptyField = record { f : empty; g : nat };
type EmptyTuple = record { empty; nat };
type EmptyFunc = func (empty) -> (empty);
type EmptyVec = vec empty;
type EmptyOpt = opt empty;
