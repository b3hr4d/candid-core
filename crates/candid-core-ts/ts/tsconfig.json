{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@candid-core/schema": [
        "./schema.ts"
      ]
    }
  },
  "include": [
    "../tests/goldens/**/*.ts",
