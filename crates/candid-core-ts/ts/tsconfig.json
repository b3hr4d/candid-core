    "./schema.ts",
    "./validate.ts",
    "./contract.ts",
    "./labels.ts",
    "./options.ts",
    "./principal-text.ts",
    "./typetable.ts",
    "./codec.ts",
    "./forms.ts",
    "./tests/**/*.ts"
  ]
}
