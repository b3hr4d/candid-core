/target/
.DS_Store

# Local-only repositories and metadata that must never enter Candid Core.
/.gitexclude-local
/candid-scope/

# Running the Python conformance reference (tests/fixtures/conformance/
# verify_vectors.py) compiles bytecode next to the script.
__pycache__/

# `fuzz/` is a separate cargo project, so the root `/target/` rule misses it.
# `corpus/` is the working corpus cargo-fuzz grows during a run; the tracked
# seed and regression inputs live in `fuzz/seeds/` and `fuzz/regressions/`.
# `artifacts/` holds crash reproducers, which CI uploads rather than commits.
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# The golden-TypeScript type-check installs its pinned compiler here
# (crates/candid-core-ts/ts). Only package.json and package-lock.json are
# tracked; the installed tree never is.
/crates/candid-core-ts/ts/node_modules/

# `crates/candid-core-wasm/` is a separate cargo project (like fuzz/), so the
# root `/target/` rule misses it. `npm/wasm/` is wasm-pack build output —
# rebuilt from the pinned toolchain, never committed — and `npm/node_modules/`
# the pinned dev-dependency install.
/crates/candid-core-wasm/target/
/crates/candid-core-wasm/npm/wasm/
/crates/candid-core-wasm/npm/node_modules/

# The documentation site is generated from website/content; the build output
# is not committed. Build it with `node website/build.mjs`.
/website/dist/
