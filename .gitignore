/target/
.DS_Store

# Local-only repositories and metadata that must never enter Candid Core.
/.gitexclude-local
/candid-scope/

# Running the Python conformance reference (tests/fixtures/conformance/
# verify_vectors.py) compiles bytecode next to the script.
__pycache__/

# `fuzz/` is a separate cargo project, so the root `/target/` rule misses it.
# `corpus/` is the working corpus cargo-fuzz grows during a run; the tracked
# seed and regression inputs live in `fuzz/seeds/` and `fuzz/regressions/`.
# `artifacts/` holds crash reproducers, which CI uploads rather than commits.
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# `website/wasm` is a separate cargo project too, and the module it produces is
# a build output: CI rebuilds it from these sources before deploying the page,
# and `website/build.sh` does the same locally. A checked-in `.wasm` would be a
# ~800 KiB binary in every clone that nothing verifies against its source.
/website/wasm/target/
/website/app/candid_core_web.wasm
