{
  // Saving a file must never change it.
  //
  // The user profile on this machine sets "editor.formatOnSave": true globally
  // *and* inside a dozen per-language blocks. A workspace-level global-only
  // override would lose to the user's own [typescript] block, so the override
  // is written per language, at the same specificity.
  //
  // Scoped to the languages Prettier is wired for. Every other language —
  // Rust in particular, where format-on-save keeps `cargo fmt --check` green —
  // keeps whatever the user profile already does. Set "editor.formatOnSave" to
  // false at the top level of this file to make the rule workspace-wide.
  //
  // Formatting still happens automatically, just at moments where a rewrite is
  // expected rather than surprising: when an agent finishes an edit
  // (.claude/hooks/format-typescript.sh) and when a commit is made
  // (.githooks/pre-commit). Shift+Alt+F stays available on demand.
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false
  },

  // Use the version pinned in ts/package-lock.json, not whatever the extension
  // happens to bundle. The extension's Prettier moves on its own release
  // schedule, and a formatter that disagrees with CI by a minor version is
  // exactly the churn this setup exists to remove.
  "prettier.prettierPath": "crates/candid-core-ts/ts/node_modules/prettier",

  // Fail closed: with no resolvable config, format nothing at all. Without
  // this, a file outside the config's reach would be formatted with the user's
  // global ~/.prettierrc ("semi": false) — which would strip the semicolons
  // from every TypeScript file in this repository.
  "prettier.requireConfig": true,

  // ~/.editorconfig is another config this repository does not control.
  // .prettierrc.json is the single source of truth.
  "prettier.useEditorConfig": false,

  // rust-analyzer settings below. One symptom they deliberately do *not* fix,
  // because it is not repository state: if the editor shows a flood of errors
  // that `cargo check` does not — `unresolved-macro-call` on `format!` and
  // `write!`, then knock-on `expected String, found str` — the sysroot is
  // behind the extension's bundled server, which tracks recent stable. This
  // repository pins no toolchain on purpose (CI channels are rolling), so the
  // fix is `rustup update stable`, not a setting. Measured here: 523 phantom
  // errors on Rust 1.91.1 and 1.93.1, zero from 1.94.0 on.

  // Analyse with every feature on. That is an editor setting, not a relaxation
  // of the boundary claim: `candid-core-ts` has no default features on purpose,
  // so rust-analyzer at Cargo's defaults greys out `TsNames::from_source_info`
  // and the whole of tests/golden.rs and tests/wire_vectors.rs — about a
  // thousand lines with no completion, no go-to-definition and no diagnostics.
  // The featureless build stays enforced where enforcement belongs, by
  // `cargo check -p candid-core-ts --locked` in CI.
  //
  // `"all"` rather than `["candid-core-ts/compiler"]` because one value is
  // applied to every linked project below, and a package-qualified feature is a
  // hard error in a workspace that does not contain that package — it would
  // stop `fuzz/` loading at all.
  "rust-analyzer.cargo.features": "all",

  // Name the workspaces rather than let discovery guess. `fuzz/` is its own
  // workspace root and is invisible to rust-analyzer unless it is listed, so
  // every fuzz target otherwise reads "file not included in any crate".
  // Listing both also fences the set: no untracked sibling checkout under this
  // directory can become a third project and fill the Problems panel with
  // errors from code this repository does not own.
  "rust-analyzer.linkedProjects": ["Cargo.toml", "fuzz/Cargo.toml"]
}
